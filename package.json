{
  "name": "artifact-gallery-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "artifact-server": "bun apps/artifact-server/src/index.ts",
    "gallery": "bun apps/gallery/src/index.ts",
    "gallery:dev": "bun run --cwd apps/gallery dev",
    "gallery:build": "bun run --cwd apps/gallery build",
    "test": "bun test apps",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
